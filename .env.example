# Kopieren nach .env.local und mit echtem Key befüllen.
# Copy to .env.local and fill in a real key.
# Anthropic API-Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here
# Optional: Modelle pro Aufrufart überschreiben (siehe lib/claude.ts).
# content:draft-curriculum (Domain-Entwürfe, Blueprint-Extraktion) nutzt das
# teurere, content:draft-lessons (Lektionen+Fragen, Remediation) das
# günstigere Modell - beide sind unabhängig konfigurierbar, kein globales
# GEMINI_MODEL-Äquivalent mehr.
# CLAUDE_CURRICULUM_MODEL=claude-sonnet-4-5
# CLAUDE_LESSONS_MODEL=claude-haiku-4-5
# Optional: Wiederholungsversuche bei vorübergehenden 429/5xx-/Netzwerkfehlern.
ANTHROPIC_MAX_ATTEMPTS=5
ANTHROPIC_RETRY_BASE_MS=2000
# Optional: Preis pro 1 Mio. Tokens für die Kostenschätzung pro Job (siehe
# Admin > Zertifizierung > KI-Inhaltsgenerierung) - getrennt pro Modell, da
# Curriculum- und Lessons-Modell unterschiedlich bepreist sind. Ohne diese
# Werte bleibt die geschätzte Kostenanzeige leer statt eine erfundene Zahl zu
# zeigen.
# ANTHROPIC_CURRICULUM_PRICE_PER_MILLION_PROMPT_TOKENS_USD=
# ANTHROPIC_CURRICULUM_PRICE_PER_MILLION_COMPLETION_TOKENS_USD=
# ANTHROPIC_LESSONS_PRICE_PER_MILLION_PROMPT_TOKENS_USD=
# ANTHROPIC_LESSONS_PRICE_PER_MILLION_COMPLETION_TOKENS_USD=
# Optional: harte Obergrenze (USD, kumuliert über alle Jobs) für neue
# KI-Generierungsjobs. Setzt die Preis-Variablen oben voraus, um überhaupt
# Kosten schätzen zu können. Bereits erzeugte Inhalte werden bei erreichtem
# Budget weiterhin ausgeliefert, nur neue Jobs werden blockiert.
# ANTHROPIC_BUDGET_USD=

# Cloudflare Tunnel Token (Zero Trust -> Networks -> Tunnels -> Tunnel
# erstellen -> Typ "Cloudflared"). Nur für docker-compose auf dem
# Zielserver benötigt, nicht für die lokale Entwicklung.
TUNNEL_TOKEN=your-tunnel-token-here

# Postgres (v2-Backend). DB_USER/PASSWORD/NAME werden von docker-compose.yml an
# das postgres-Image weitergereicht (Container-Init) UND zu DATABASE_URL
# zusammengesetzt, das die App (Drizzle) sowie drizzle-kit für Migrationen
# nutzen. Für lokale Entwicklung außerhalb von Docker DATABASE_URL direkt setzen
# (Hostname "postgres" ist nur im internen Docker-Netzwerk erreichbar, dann z.B.
# localhost:${DB_PORT:-5432} verwenden).
DB_USER=certstudy
DB_PASSWORD=your-postgres-password-here
DB_NAME=certstudy
DATABASE_URL=postgres://certstudy:your-postgres-password-here@localhost:5432/certstudy
# DB_PORT=5432
# APP_PORT=3000

# Auth.js Session-Secret (process.env.AUTH_SECRET, siehe lib/server/auth.ts).
# Generieren mit: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Registrierung ist per Allowlist gesperrt (siehe app/api/register/route.ts) -
# ohne Eintrag hier kann sich niemand registrieren. Kommagetrennte E-Mail-
# Adressen, um Personen "einzuladen":
REGISTRATION_ALLOWED_EMAILS=you@example.com,friend@example.com
