# Kopieren nach .env.local und mit echtem Key befüllen.
# Copy to .env.local and fill in a real key.
# Gemini API-Key (kostenlos, kein Kreditkarte nötig): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
# Optional: Modell überschreiben (Default: gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Cloudflare Tunnel Token (Zero Trust -> Networks -> Tunnels -> Tunnel
# erstellen -> Typ "Cloudflared"). Nur für docker-compose auf dem
# Zielserver benötigt, nicht für die lokale Entwicklung.
TUNNEL_TOKEN=your-tunnel-token-here

# Postgres (v2-Backend). POSTGRES_USER/PASSWORD/DB werden vom postgres-Image
# selbst gelesen (Container-Init); DATABASE_URL muss dieselben Werte enthalten
# und wird von der App (Drizzle) sowie von drizzle-kit für Migrationen genutzt.
# Hostname "postgres" = Docker-Compose-Servicename, nur im internen Netzwerk
# erreichbar (kein Host-Port-Publish).
POSTGRES_USER=certstudy
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=certstudy
DATABASE_URL=postgres://certstudy:your-postgres-password-here@postgres:5432/certstudy

# Auth.js Session-Secret. Generieren mit: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
