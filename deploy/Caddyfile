# Reverse-Proxy-Konfiguration für learning.pwa-tree.de
#
# Auf dem Zielserver (nicht im Container) mit Caddy 2 verwenden, z. B.
# unter /etc/caddy/Caddyfile. Caddy holt und erneuert das Let's-Encrypt-
# Zertifikat automatisch (HTTPS-Zwang inklusive).
#
# Voraussetzung: DNS A/CNAME-Record für learning.pwa-tree.de zeigt auf
# diesen Server, und der learning-pwa-Container läuft lokal auf Port 3000
# (siehe docker-compose.yml).

learning.pwa-tree.de {
	# Rate-Limits: Die App liest die Client-Adresse zuerst aus CF-Connecting-IP (lib/server/auth-rate-limit.ts).
	# Das stimmt nur, solange Caddy ausschließlich über den Cloudflare-Tunnel (cloudflared) erreichbar ist und keinen
	# eigenen öffentlichen Port hat: Cloudflare überschreibt den Header, ein Client kann ihn nicht fälschen. Wird Caddy
	# jemals direkt ins Netz gestellt, muss in reverse_proxy "header_up -CF-Connecting-IP" ergänzt werden, sonst
	# lassen sich alle Begrenzungen je IP mit einem erfundenen Header umgehen.
	reverse_proxy 127.0.0.1:3000 {
		# Header für Server-Sent Events / Streaming-Antworten durchreichen.
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	encode gzip zstd
}
