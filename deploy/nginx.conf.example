# Alternative zu Caddy: Nginx-Reverse-Proxy für learning.pwa-tree.de.
# SSL-Zertifikat separat besorgen, z. B. per certbot:
#   certbot --nginx -d learning.pwa-tree.de
# (certbot ergänzt die "listen 443 ssl" / "ssl_certificate"-Direktiven
# danach automatisch in dieser Datei.)

server {
	listen 80;
	server_name learning.pwa-tree.de;
	return 301 https://$host$request_uri;
}

server {
	listen 443 ssl http2;
	server_name learning.pwa-tree.de;

	# ssl_certificate     /etc/letsencrypt/live/learning.pwa-tree.de/fullchain.pem;
	# ssl_certificate_key /etc/letsencrypt/live/learning.pwa-tree.de/privkey.pem;

	location / {
		proxy_pass http://127.0.0.1:3000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# Streaming / Server-Sent Events nicht puffern.
		proxy_buffering off;
		proxy_set_header Connection "";
	}
}
